# 复制此文件为 .env.local，把 KEY 填进去后即可启用真实 AI 调用。
# 不填的话 /api/recipe 会返回 mock 数据，依然可以演示完整流程。

# 在 https://aistudio.google.com 申请 Gemini API key（免费）
GEMINI_API_KEY=

# Supabase（P4 数据层 / 登录）
# 在 supabase.com 创建项目后，Project Settings → API 复制下方两个值
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 部署后填本站域名（OG image canonical 用）
# NEXT_PUBLIC_SITE_URL=https://glucolens-xi.vercel.app
